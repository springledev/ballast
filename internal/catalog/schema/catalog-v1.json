{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ballast.dev/schema/catalog-v1.json",
  "title": "Ballast service catalog entry (v1)",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "service", "version", "backup", "verify"],
  "properties": {
    "apiVersion": { "const": "ballast.dev/v1" },
    "service": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "version": { "type": "integer", "minimum": 1 },
    "display": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" }
      }
    },
    "detect": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "docker": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "imagePattern": { "type": "string" },
            "orEnv": {
              "type": "object",
              "additionalProperties": { "type": "string" }
            }
          }
        }
      }
    },
    "discovery": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "match"],
        "properties": {
          "type": { "enum": ["docker-label"] },
          "match": { "type": "string" },
          "fallback": { "type": "string" }
        }
      }
    },
    "parameters": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name"],
        "properties": {
          "name": { "type": "string" },
          "required": { "type": "boolean" },
          "prompt": { "type": "string" },
          "default": { "type": "string" },
          "picker": { "enum": ["docker-volume", "compose-project"] }
        }
      }
    },
    "envSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["keys"],
      "properties": {
        "prompt": { "type": "string" },
        "file": { "type": "string" },
        "keys": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["key"],
            "oneOf": [{ "required": ["param"] }, { "required": ["secret"] }],
            "properties": {
              "key": { "type": "string" },
              "param": { "type": "string" },
              "secret": { "type": "string" },
              "optional": { "type": "boolean" }
            }
          }
        }
      }
    },
    "backup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["strategy"],
      "properties": {
        "strategy": {
          "enum": ["dump", "stop-start", "files", "exec", "volume", "compose"]
        },
        "dumps": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "command"],
            "properties": {
              "name": { "type": "string" },
              "container": { "type": "string" },
              "transport": { "enum": ["docker-exec", "pct-exec"] },
              "command": { "type": "array", "minItems": 1, "items": { "type": "string" } },
              "format": { "type": "string" },
              "secretEnv": {
                "type": "object",
                "additionalProperties": false,
                "patternProperties": {
                  "^[A-Za-z_][A-Za-z0-9_]*$": { "type": "string" }
                }
              }
            }
          }
        },
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path"],
            "properties": {
              "path": { "type": "string" },
              "exclude": { "type": "array", "items": { "type": "string", "minLength": 1 } }
            }
          }
        },
        "hostPaths": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "path": { "type": "string", "minLength": 1 },
              "mount": { "type": "string", "minLength": 1 },
              "container": { "type": "string", "minLength": 1 },
              "exclude": { "type": "array", "items": { "type": "string", "minLength": 1 } }
            },
            "oneOf": [
              { "required": ["path"], "not": { "anyOf": [{ "required": ["mount"] }, { "required": ["container"] }] } },
              { "required": ["mount", "container"], "not": { "required": ["path"] } }
            ]
          }
        },
        "volumes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name"],
            "properties": {
              "name": { "type": "string" }
            }
          }
        },
        "stopStart": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "containers": { "type": "array", "items": { "type": "string" } }
          }
        },
        "compose": {
          "type": "object",
          "additionalProperties": false,
          "required": ["project"],
          "properties": {
            "project": { "type": "string", "minLength": 1 }
          }
        },
        "exec": {
          "type": "object",
          "additionalProperties": false,
          "required": ["script"],
          "properties": {
            "script": { "type": "string" },
            "args": { "type": "array", "items": { "type": "string" } },
            "verifyScript": { "type": "string" }
          }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "strategy": { "const": "dump" } } },
          "then": { "required": ["dumps"] }
        },
        {
          "if": { "properties": { "strategy": { "const": "volume" } } },
          "then": { "required": ["volumes"] }
        },
        {
          "if": { "properties": { "strategy": { "const": "compose" } } },
          "then": { "required": ["compose"] }
        }
      ]
    },
    "verify": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "method": { "$ref": "#/$defs/verifyMethod" },
        "methods": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/verifyMethod" }
        },
        "image": { "type": "string" },
        "filterStderr": { "type": "array", "items": { "type": "string" } },
        "restartPolicy": { "enum": ["never", "always"] },
        "smoke": {
          "type": "object",
          "additionalProperties": false,
          "required": ["container"],
          "properties": {
            "container": { "type": "string", "minLength": 1 },
            "timeout": { "type": "string", "pattern": "^[0-9]+(ms|s|m)$" },
            "http": {
              "type": "object",
              "additionalProperties": false,
              "required": ["port"],
              "properties": {
                "port": { "$ref": "#/$defs/port" },
                "path": { "type": "string", "pattern": "^/" },
                "expectStatus": { "type": "integer", "minimum": 100, "maximum": 599 }
              }
            },
            "tcp": {
              "type": "object",
              "additionalProperties": false,
              "required": ["port"],
              "properties": {
                "port": { "$ref": "#/$defs/port" }
              }
            }
          },
          "not": { "required": ["http", "tcp"] }
        }
      },
      "oneOf": [
        { "required": ["method"] },
        { "required": ["methods"] }
      ],
      "allOf": [
        {
          "if": {
            "anyOf": [
              { "required": ["method"], "properties": { "method": { "enum": ["db-restore-drill", "container-restore"] } } },
              { "required": ["methods"], "properties": { "methods": { "contains": { "enum": ["db-restore-drill", "container-restore"] } } } }
            ]
          },
          "then": { "required": ["image"] }
        },
        {
          "if": {
            "anyOf": [
              { "required": ["method"], "properties": { "method": { "const": "restart-smoke" } } },
              { "required": ["methods"], "properties": { "methods": { "contains": { "const": "restart-smoke" } } } }
            ]
          },
          "then": { "required": ["smoke"] }
        }
      ]
    },
    "notifications": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "failureVerbosity": { "enum": ["full", "brief"] },
        "successHeartbeat": { "type": "boolean" }
      }
    }
  },
  "$defs": {
    "verifyMethod": {
      "enum": ["archive-integrity", "db-restore-drill", "container-restore", "read-back", "restart-smoke", "exec-script", "compose-config"]
    },
    "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
  }
}
